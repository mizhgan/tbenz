PORT=4000
MONGO_URI=mongodb://localhost:27017/gas-station-tracker
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
TBANK_API_BASE_URL=https://toplivo.tbank.ru/api/v1/stations
MIN_POLL_INTERVAL_MINUTES=1
CORS_ORIGIN=*
# Consecutive failures on one proxy before it's auto-disabled.
PROXY_FAILURE_THRESHOLD=3
PROXY_REQUEST_TIMEOUT_MS=20000
# URL used by the admin "check proxy" action; defaults to the data source itself.
PROXY_CHECK_URL=https://toplivo.tbank.ru/api/v1/stations
# Optional: Telegram bot token from @BotFather. Leave unset to disable the
# Telegram bot feature entirely (admin panel will show it as "not configured").
TELEGRAM_BOT_TOKEN=
